<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rover_bringup</name>
  <version>1.0.0</version>
  <description>Launch files and top-level configuration for the autonomous rover.</description>
  <maintainer email="rover@example.com">Rover Team</maintainer>
  <license>MIT</license>

  <exec_depend>rover_serial</exec_depend>
  <exec_depend>rover_camera</exec_depend>
  <exec_depend>rover_tracking</exec_depend>
  <exec_depend>rover_navigation</exec_depend>
  <exec_depend>rover_control</exec_depend>
  <exec_depend>rover_dashboard</exec_depend>
  <exec_depend>rover_interfaces</exec_depend>

  <buildtool_depend>ament_python</buildtool_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
